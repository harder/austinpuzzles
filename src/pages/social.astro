---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialPanel from '../components/SocialPanel.astro';
---

<BaseLayout
  title="Social Hub | Austin Puzzle Exchange"
  description="Join the Austin Puzzle Exchange Facebook Page and Group, or connect on X, Instagram, Threads, and Bluesky."
>
  <section class="container page-intro reveal-on-scroll">
    <p class="eyebrow">Connect</p>
    <h1>Follow Austin Puzzle Exchange</h1>
    <p>Start with our Facebook Page for announcements and our Group for neighbor-to-neighbor conversation. Other channels are linked below.</p>
  </section>

  <section class="container section-stack">
    <SocialPanel expanded={true} sectionId="social-full" />
  </section>
</BaseLayout>
