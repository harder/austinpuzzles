---
interface Props {
  index?: number;
  slug: string;
  name: string;
  neighborhood: string;
  schedule: string;
  details: string;
  heroImage?: string;
  addressLabel: string;
  amenities: string[];
}

const { index, slug, name, neighborhood, schedule, details, heroImage, addressLabel, amenities } = Astro.props;
---

<article class="location-card reveal-on-scroll">
  <div class="location-card__visual">
    {heroImage && <img src={heroImage} alt="" loading="lazy" class="location-card__image" />}
    {index && <span class="location-card__index">{String(index).padStart(2, '0')}</span>}
  </div>
  <div class="location-card__content">
    <p class="eyebrow location-card__neighborhood">Austin / {neighborhood}</p>
    <h3>{name}</h3>
    <p class="location-card__address">{addressLabel}</p>
    <p>{details}</p>
    <p class="location-card__hours"><span aria-hidden="true">◷</span> {schedule}</p>
    {amenities.length > 0 && (
      <ul class="pill-list">
        {amenities.map((item) => <li>{item}</li>)}
      </ul>
    )}
    <a class="text-link" href={'/locations/' + slug}>Visit this swap <span aria-hidden="true">→</span></a>
  </div>
</article>
