---
interface Props {
  expanded?: boolean;
  sectionId?: string;
}

const { expanded = false, sectionId = 'social' } = Astro.props;
const socialLinks = [
  { label: 'Facebook Page', href: 'https://www.facebook.com/atxpuzzles', icon: '/icons/social/facebook-brand.svg' },
  { label: 'Facebook Group', href: 'https://www.facebook.com/groups/austinpuzzles', icon: '/icons/social/facebook-brand.svg' },
  { label: 'Instagram', href: 'https://www.instagram.com/austinpuzzles', icon: '/icons/social/instagram-brand.svg' },
  { label: 'Threads', href: 'https://www.threads.net/@austinpuzzles', icon: '/icons/social/threads-brand.svg' },
  { label: 'X / Twitter', href: 'https://x.com/AustinPuzzles', icon: '/icons/social/x-brand.svg' },
  { label: 'Bluesky', href: 'https://bsky.app/profile/austinpuzzles.com', icon: '/icons/social/bluesky-brand.svg' }
];
---

<section
  id={sectionId}
  class={'social-panel reveal-on-scroll ' + (expanded ? 'social-panel--expanded' : 'social-panel--compact')}
  aria-labelledby="social-title"
>
  <div class="social-panel__header">
    <p class="eyebrow">Stay in the loop</p>
    <h2 id="social-title">The community is <em>part of the fun.</em></h2>
    <p>Facebook is the best place for exchange updates and conversations with Austin neighbors.</p>
  </div>

  <div class="social-feature-grid">
    <article class="social-feature">
      <p class="eyebrow">Official updates</p>
      <h3>Facebook Page</h3>
      <p>Location news, photos, and announcements from Austin Puzzle Exchange.</p>
      <a class="text-link" href="https://www.facebook.com/atxpuzzles" target="_blank" rel="noopener noreferrer">Visit the Page <span aria-hidden="true">↗</span></a>
    </article>
    <article class="social-feature">
      <p class="eyebrow">Neighbor to neighbor</p>
      <h3>Facebook Group</h3>
      <p>Join the community conversation and share what you are puzzling over.</p>
      <a class="text-link" href="https://www.facebook.com/groups/austinpuzzles" target="_blank" rel="noopener noreferrer">Visit the Group <span aria-hidden="true">↗</span></a>
    </article>
  </div>

  <div class="social-x-card">
    <div>
      <p class="eyebrow">Also on X</p>
      <h3>Posts from @AustinPuzzles</h3>
      <p>Open our X profile for the latest posts, or try the live timeline here. X may not show posts in its embed for every visitor.</p>
      <div class="button-row">
        <button class="button button--secondary button--small" type="button" data-load-x aria-controls="social-x-timeline" aria-expanded="false">Show X timeline</button>
        <a class="text-link" href="https://x.com/AustinPuzzles" target="_blank" rel="noopener noreferrer">Open on X <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div id="social-x-timeline" class="social-x-timeline" data-x-timeline hidden>
      <a class="twitter-timeline" data-height={expanded ? '520' : '420'} data-dnt="true" href="https://twitter.com/AustinPuzzles">Posts by @AustinPuzzles</a>
      <p class="social-embed-note">If posts do not appear, <a href="https://x.com/AustinPuzzles" target="_blank" rel="noopener noreferrer">view the profile directly on X</a>.</p>
    </div>
  </div>

  {expanded && <p class="social-panel__note">Facebook does not provide a reliable public Group feed for a static site. The Page and Group links remain available even when third-party embeds are blocked.</p>}

  <h3 class="social-panel__more-title">More ways to connect</h3>
  <ul class="social-links-grid" aria-label="Austin Puzzle Exchange social profiles">
    {socialLinks.map((item) => (
      <li>
        <a href={item.href} target="_blank" rel="noopener noreferrer">
          <img src={item.icon} alt="" loading="lazy" aria-hidden="true" width="24" height="24" />
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>

  {!expanded && <div class="button-row social-panel__cta"><a class="button button--secondary" href="/social/">Explore all our channels <span aria-hidden="true">↗</span></a></div>}
</section>

<script>
  const panel = document.querySelector<HTMLElement>('.social-panel');
  const timelineButton = panel?.querySelector<HTMLButtonElement>('[data-load-x]');
  const timeline = panel?.querySelector<HTMLElement>('[data-x-timeline]');

  timelineButton?.addEventListener('click', () => {
    if (!timeline) return;
    const opening = timeline.hidden;
    timeline.hidden = !opening;
    timelineButton.setAttribute('aria-expanded', String(opening));
    timelineButton.textContent = opening ? 'Hide X timeline' : 'Show X timeline';

    if (opening && !document.getElementById('twitter-wjs')) {
      const script = document.createElement('script');
      script.id = 'twitter-wjs';
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      script.addEventListener('error', () => {
        timelineButton.textContent = 'X timeline unavailable';
      });
      document.head.append(script);
    }
  });
</script>
